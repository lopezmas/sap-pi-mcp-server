SAP_PI_HOST=your-pi-host:50000
SAP_PI_SCHEME=https
SAP_PI_USER=your-user
SAP_PI_PASSWORD=your-password

# Recovery writes are disabled by default. Classify the connected tenant accurately.
SAP_PI_ENABLE_RECOVERY=false
SAP_PI_ENVIRONMENT=dev

# Channel writes are independently disabled by default.
SAP_PI_ENABLE_CHANNEL_CONTROL=false
SAP_PI_ENABLE_PROD_CHANNEL_CONTROL=false
